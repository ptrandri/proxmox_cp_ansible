SERVICE_URL_N8N={{ app_service_url | string | to_json }}
N8N_DOMAIN={{ app_host | string | to_json }}
N8N_PROTOCOL={{ app_protocol | string | to_json }}
N8N_SECURE_COOKIE={{ app_secure_cookie | string | lower | to_json }}
TIMEZONE={{ app_timezone_effective | string | to_json }}
{% if n8n_owner_provisioning_effective | bool %}
N8N_INSTANCE_OWNER_EMAIL={{ n8n_owner_email | string | to_json }}
N8N_INSTANCE_OWNER_FIRST_NAME={{ n8n_owner_first_name | string | to_json }}
N8N_INSTANCE_OWNER_LAST_NAME={{ n8n_owner_last_name | string | to_json }}
N8N_INSTANCE_OWNER_PASSWORD_HASH={{ n8n_password_hash_effective | string | replace('$', '$$') | to_json }}
{% endif %}
SERVICE_USER_POSTGRES={{ n8n_postgres_user_effective | string | replace('$', '$$') | to_json }}
SERVICE_PASSWORD_POSTGRES={{ n8n_postgres_password_effective | string | replace('$', '$$') | to_json }}
SERVICE_PASSWORD_REDIS={{ n8n_redis_password_effective | string | replace('$', '$$') | to_json }}
SERVICE_PASSWORD_ENCRYPTION={{ n8n_encryption_key_effective | string | replace('$', '$$') | to_json }}
